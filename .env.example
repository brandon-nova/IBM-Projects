# Copy to .env.local if that file does not exist yet.
# Step-by-step setup: docs/SUPABASE_SETUP.md
# Use a hosted Supabase project's Connect/API settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Provisioning scripts ONLY; the running application does not need this key.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace admin
# Must be explicitly true before synthetic seeding against a hosted database.
ALLOW_REMOTE_DEMO_SEED=false
