# Copy to .env.local. Values from `supabase status` for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# server-side provisioning scripts ONLY; never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace admin
# Must be explicitly true before synthetic seeding against a hosted database.
ALLOW_REMOTE_DEMO_SEED=false
