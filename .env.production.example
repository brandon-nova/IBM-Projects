# Copy to .env.production. It is ignored by Git.
# Used by npm run cf:build, cf:preview, and cf:deploy.
# These public values are embedded during the Next.js build.
NEXT_PUBLIC_APP_URL=https://projects.fncai.org
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: set true only to publish the public homepage before Supabase setup.
# Both Supabase values must be empty for that mode. Protected pages stay closed.
CLOUDFLARE_PUBLIC_PREVIEW=false

# No service-role key, database password, or SMTP secret belongs in this file.
# Authenticate Cloudflare with npm run cf:login instead.
