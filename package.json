{
  "name": "ibm-projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:setup": "npm install --save-dev @opennextjs/cloudflare@1 wrangler@4",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:build": "node --env-file-if-exists=.env.production scripts/cloudflare.mjs build",
    "cf:preview": "node --env-file-if-exists=.env.production scripts/cloudflare.mjs preview",
    "cf:deploy": "node --env-file-if-exists=.env.production scripts/cloudflare.mjs deploy",
    "cf:verify": "node scripts/verify-deployment.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/cloudflare.test.mjs",
    "test:integration": "node --env-file-if-exists=.env.test --test tests/integration.test.mjs",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.10",
    "supabase": "^2.67.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
